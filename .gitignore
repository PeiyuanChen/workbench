# ── 真实用户数据（不入库） ──
data/users/me/

# ── T2 一次性迁移的仓外 zip 备份（默认在仓库外，此条兜底） ──
.migration-backups/

# ── Python ──
__pycache__/
*.pyc
*.pyo
backend/.venv/
backend/dist/
*.egg-info/

# ── 前端构建产物 ──
frontend/dist/
frontend/node_modules/

# ── Claude Code 本地配置（含 API key） ──
.claude/settings.local.json

# ── 编辑器 / OS ──
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ── 测试 / 缓存 ──
.pytest_cache/
.coverage
htmlcov/

# ── 一键启动 dev.sh 产生的运行日志 ──
.dev-*.log
